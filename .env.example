# ============================================================
#  URL Shortener & Redirect System — environment variables
#  Copy this file to .env.local and fill in your own values.
#  NEVER put real keys in this file — it IS committed to git.
# ============================================================

# ---- Firebase WEB config (public, safe to expose) ----------
# From Firebase console -> Project settings -> Your apps -> Web app
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxx
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ---- Firebase Admin SDK (server-side, PRIVATE) -------------
# Firebase console -> Project settings -> Service accounts -> "Generate new private key"
# Paste the values here (the private key must stay on ONE line).
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n.....\n-----END PRIVATE KEY-----\n"

# ---- Admin access -------------------------------------------
# Method 1: shared secret typed at /admin. Use a long random string.
ADMIN_KEY=change-me-to-a-long-random-string
# Method 2: Google sign-in allowlist (comma-separated emails). Leave empty to disable.
ADMIN_EMAILS=you@example.com

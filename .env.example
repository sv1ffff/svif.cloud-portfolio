# ============================================================
#  Local environment — copy your real Firebase values here.
#  This file is NOT committed to git (.gitignore).
# ============================================================

# ---- Firebase WEB config (public, safe to expose) ----------
# From Firebase console -> Project settings -> Your apps -> Web app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ---- Firebase Admin SDK (server-side, PRIVATE) -------------
# Firebase console -> Project settings -> Service accounts -> Generate new private key
FIREBASE_PROJECT_ID=
FIREBASE_DATABASE_URL=
FIREBASE_CLIENT_EMAIL=
# ---- Admin access -------------------------------------------
# Method 1: shared secret typed at /admin (set any long random string)
ADMIN_KEY=
# Method 2: Google sign-in allowlist (comma-separated emails). Leave empty to disable.
ADMIN_EMAILS=
